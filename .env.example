# MatchMaker bot — environment template. Copy this file to .env and fill in the required
# values below. Everything else (roles, categories, channels) is configured per-server by
# running /matchmaker-setup as an admin after inviting the bot — no more manual ID-pasting into
# .env for a new server.

# ── Discord app (required) ──────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=

# ── Bot developer identity (optional — /post-update and the #suggestions DM forward are disabled
# until this is set) ─────────────────────────────────────────────────────────
# Your own Discord user ID (right-click your name with Developer Mode on -> Copy User ID). Gates
# the owner-only /post-update changelog command (changelog.js) and is where #suggestions
# submissions get DMed (suggestions.js's forwardSuggestionToOwner) — the bot's one cross-server
# "reach the developer" identity, not any per-guild server-owner concept.
BOT_OWNER_DISCORD_ID=

# ── Database (required) ─────────────────────────────────────────────────────
# MongoDB connection string — required. Per-guild config (roles/channels/categories) is
# Mongo-only; queue/party/match data falls back to a local data.json file if this is
# unreachable, but guild config has no offline equivalent.
MONGODB_URI=

# ── Epic account linking (required for account linking — disabled until these are set) ─────
# The sole path for linking a player's Epic account (epic-oauth.js). Without these set, the
# Link Epic Account button in #register tells players linking isn't set up yet.
# Client ID/secret from the Epic Games Developer Portal (dev.epicgames.com) for an app with the
# "basic_profile" scope enabled.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
# Must exactly match the redirect URI registered for your app on the Epic Games Developer Portal,
# and point at this same webhook server's /epic-callback route, e.g.
# https://<your-domain>/epic-callback. Uses the same PORT/public-exposure setup as
# STRIPE_WEBHOOK_SECRET below — no separate server or port.
EPIC_REDIRECT_URI=

# ── Discord OAuth / "pay through the website" (optional — falls back to the /premium Discord
# command only, until these are set) ────────────────────────────────────────────────────────
# Lets a website hand off straight into Stripe Checkout without its own Discord session: the
# visitor logs in with Discord (identify scope only) so the callback can learn their Discord ID,
# then it's passed straight to billing.js's createCheckoutSession — see discord-oauth.js and
# webhook-server.js's /premium/:plan and /discord-checkout-callback routes. Reuses CLIENT_ID above
# (same Discord application as the bot) rather than a separate client id.
# OAuth2 client secret for this same Discord application (CLIENT_ID above) — from the OAuth2 tab
# in the Discord Developer Portal, NOT the bot token.
DISCORD_CLIENT_SECRET=
# Must match a redirect URL registered on that same OAuth2 tab, pointing at this webhook server's
# /discord-checkout-callback route, e.g. https://<your-domain>/discord-checkout-callback.
DISCORD_OAUTH_REDIRECT_URI=

# ── Payments (optional — subscriptions are disabled until these are set) ───────────────────
# Stripe secret key (test or live), from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable key — not used server-side today (this bot has no web frontend), kept here for
# completeness/future use.
STRIPE_PUBLISHABLE_KEY=
# Signing secret for the webhook endpoint (webhook-server.js) — from the Stripe Dashboard's
# Webhooks page, or `stripe listen`'s output while testing locally.
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (price_...) for the Monthly (£2.99) and Yearly (£28.99) products — create
# these in the Stripe Dashboard ahead of time. No trial price — the free trial is bot-managed
# (access.js), never touches Stripe at all.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Where Stripe redirects the browser after Checkout succeeds/is cancelled. This bot has no web
# frontend — any valid https:// page works; a Discord invite link back to your server is a
# reasonable default.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Port the Stripe webhook HTTP server (webhook-server.js) listens on. You must separately expose
# this port publicly (reverse proxy or a tunnel like ngrok/Cloudflare Tunnel) and register
# https://<your-domain>/stripe/webhook in the Stripe Dashboard — neither step can be automated
# here.
PORT=3000
# Secret for the GitHub auto-deploy webhook (webhook-server.js's /deploy route). Register
# https://<your-domain>/deploy as a webhook on the bot-public repo (content type
# application/json, "Just the push event"), using this same value as its secret — GitHub signs
# each delivery with it (X-Hub-Signature-256), so only genuine pushes can trigger a deploy. Only
# pushes to main run `git pull && pm2 restart matchmaker-beta`; anything else is ignored.
DEPLOY_WEBHOOK_SECRET=

# ── Fortnite Tracker scraping proxy (optional — direct requests get blocked outright, so this
# is effectively required for scraping to work at all in practice, but the bot still starts and
# runs fine without it set; scraper.js/tournament-scraper.js just log which mode they're in) ──
# Residential proxy host/port (e.g. a Bright Data/Smartproxy/etc. endpoint) — set PROXY_HOST to
# switch both Puppeteer scrapers over to it; leave blank to launch direct exactly as before.
PROXY_HOST=
PROXY_PORT=
# Proxy auth credentials — passed via page.authenticate(), not baked into PROXY_HOST/PROXY_PORT.
PROXY_USERNAME=
PROXY_PASSWORD=

# ── Epic competitive API (optional — epic-api.js's build-mode cross-check and Epic-sourced
# own-tournament placement lookup are both skipped, falling back to the existing Fortnite Tracker-
# only behavior, until this is set) ─────────────────────────────────────────────────────────
# API key for api-fortnite.com, an unofficial wrapper around Epic's own real competitive-tournament
# backend (not Fortnite Tracker) — sent as the x-api-key header on every request. Has its own real
# rate limits and credit system (see epic-api.js's caching), so don't share this key across
# unrelated tools/bots.
FORTNITE_API_KEY=

# ── Legacy single-guild migration (do not set for a new install) ───────────
# These only matter if you're upgrading a bot instance that ran the original single-server
# version of MatchMaker (env-var-configured roles/channels/categories for exactly one guild).
# If set, GUILD_ID's existing role/channel/category IDs below are copied into that guild's
# Mongo config once, automatically, on first startup after upgrading — then these variables
# can be deleted. A brand-new install should leave this whole section blank.
GUILD_ID=
ROLE_CONSOLE=
ROLE_PC=
ROLE_MOBILE=
ROLE_EU=
ROLE_ME=
ROLE_NAC=
ROLE_IGL=
ROLE_FRAGGER=
MOD_ROLE_ID=
CATEGORY_EU=
CATEGORY_NAC=
CATEGORY_ME=
GET_ROLES_CHANNEL_ID=
FORM_PARTY_CHANNEL_ID=
HOWTO_CHANNEL_ID=
MATCH_CATEGORY_ID=
